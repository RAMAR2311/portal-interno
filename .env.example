POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=chatmc

# URL si Flask corre DENTRO de Docker (usando el hostname del servicio 'db')
DATABASE_URL=postgresql://postgres:admin123@db:5432/chatmc

# (Nota: Si Flask se ejecuta FUERA de Docker en desarrollo, usar: postgresql://postgres:admin123@localhost:5432/chatmc)
